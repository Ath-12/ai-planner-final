# Copy this file to .streamlit/secrets.toml and fill in your own keys.
# secrets.toml is git-ignored, never commit real keys.
# On Streamlit Community Cloud, paste the same lines into App settings → Secrets.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY = ""

# Optional: change the Gemini model without touching the code
# GEMINI_MODEL = "gemini-3-flash-preview"

# Optional: Perplexity key for AI-picked booking/review links
PPLX_API_KEY = ""

# Optional: ExchangeRate-API key for live currency conversion
EXCHANGE_RATE_API_KEY = ""
